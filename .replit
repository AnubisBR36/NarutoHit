modules = ["php-8.2", "nodejs-20", "web", "postgresql-16"]
run = "Faça esse site funcionar"

[nix]
channel = "stable-25_05"
packages = ["sqlite"]

[deployment]
run = ["sh", "-c", "Faça esse site funcionar"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Executar Site"
author = 43114555
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000"

[[workflows.workflow]]
name = "Web Server"
author = 43114555
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t ."

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "php-server"

[[workflows.workflow]]
name = "php-server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_app.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
